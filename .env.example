# Local (non-docker) runs only. The compose stack sets these itself in
# docker-compose.yml — see docker-compose.example.yml.

# SoundCloud credentials (see README for how to obtain these)
SCS_CLIENT_ID=your_client_id
SCS_OAUTH_TOKEN=OAuth 2-xxxxxx-xxxxxxxxx-xxxxxxxxxxxxxx

# Directories
SCS_TEMP_DIR=./temp
SCS_LIBRARY_DIR=./library
SCS_BACKUP_DIR=./backups

# Database (postgres)
SCS_DB_HOST=localhost
SCS_DB_PORT=5432
SCS_DB_USER=scsuck
SCS_DB_PASSWORD=changeme
SCS_DB_NAME=scsuck

# Comma-separated lists of permalinks or user ids
SCS_SYNC_FOLLOWERS=
SCS_ADDITIONAL_ARTISTS=
SCS_EXCLUDE_ARTISTS=

# Milliseconds to wait between downloads
SCS_RATE_LIMIT=1000

# Hours between automatic DB backups on run (0 disables)
SCS_BACKUP_INTERVAL=24

# Skip artists whose last completed discovery was within this many hours
# (lets an interrupted run resume where it left off; 0 = always discover)
SCS_DISCOVERY_INTERVAL=6

# Optional proxy
SCS_PROXY_HOST=
SCS_PROXY_PORT=
SCS_PROXY_USERNAME=
SCS_PROXY_PASSWORD=

# Optional Pushover notifications
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

SCS_DEBUG=false
